{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "7200000",
    "CLAUDE_DEBUG": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "🤖 Generated with Claude Code\n\nCo-Authored-By: Claude",
    "pr": "🤖 Generated with Claude Code"
  },
  "permissions": {
    "deny": []
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-create.sh",
            "timeout": 60000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-hooks/worktree-binding-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-enforcement-fallback.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-enforcement-fallback.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-hooks/worktree-binding-guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lisa-wiki@lisa": true,
    "lisa@lisa": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "lisa-typescript@lisa": true,
    "typescript-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "cc-safety-net@cc-marketplace": true,
    "safety-net@cc-marketplace": false
  },
  "extraKnownMarketplaces": {
    "CodySwannGT/lisa": {
      "source": {
        "source": "github",
        "repo": "CodySwannGT/lisa"
      }
    },
    "kenryu42/cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "kenryu42/cc-marketplace"
      }
    }
  },
  "plansDirectory": "./plans",
  "version": "1.0.0",
  "projectRoot": "/Users/cody/workspace/aws-setup",
  "memoryLimit": 2048,
  "ignoredPatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".git/**",
    ".env",
    "*.log",
    "*.lock",
    ".next/**",
    "coverage/**"
  ],
  "mcpPreferences": {
    "useMcpWhenAvailable": true,
    "preferMcpOverInternal": true
  }
}
