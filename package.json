{
  "devDependencies": {
    "@ast-grep/cli": "^0.42.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.3",
    "husky": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@codyswann/lisa": "4.69.1",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^22.19.19",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint-plugin-oxlint": "^1.62.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "knip": "^5.88.1",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.24.0",
    "semver": "^7.8.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.2",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "fast-check": "^4.9.0"
  },
  "scripts": {
    "build": "tsup",
    "format:check": "$npm_execpath run format:check:lisa",
    "knip:check": "$npm_execpath run knip:check:lisa",
    "lint": "$npm_execpath run lint:lisa",
    "lint:slow": "$npm_execpath run lint:slow:lisa",
    "postinstall": "[ -n \"$CI\" ] || LISA_BOOTSTRAP=1 node node_modules/@codyswann/lisa/all/copy-overwrite/scripts/lisa-postinstall.mjs || true",
    "sg:scan": "$npm_execpath run sg:scan:lisa",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:cov:unit": "$npm_execpath run test:cov:unit:lisa",
    "test:integration": "$npm_execpath run test:integration:lisa",
    "test:node": "$npm_execpath run test:node:lisa",
    "test:unit": "vitest run --exclude='**/integration/**'",
    "test:watch": "vitest",
    "typecheck": "$npm_execpath run typecheck:lisa",
    "dev": "tsup --watch",
    "lint:fix": "node scripts/lib/worktree-dependencies.mjs && oxlint --fix && eslint . --fix",
    "format": "node scripts/lib/worktree-dependencies.mjs && prettier --check . --write",
    "knip:fix": "node scripts/lib/worktree-dependencies.mjs && knip --fix",
    "setup:deploy-key": "setup-deploy-key",
    "prepublishOnly": "$npm_execpath run build",
    "prepare": "$npm_execpath run build && husky install || true",
    "check:conflict-markers": "node scripts/check-conflict-markers.mjs",
    "check:skipped-required-checks": "node scripts/check-skipped-required-checks.mjs",
    "check:third-party-action-pins": "node scripts/check-third-party-action-pins.mjs --warn",
    "check:vacuous-required-checks": "node scripts/check-skipped-required-checks.mjs --vacuity",
    "check:verification": "node scripts/check-verification-coverage.mjs",
    "check:work-item": "node scripts/lisa-work-item.mjs validate-pr",
    "check:work-item:push": "node scripts/lisa-work-item.mjs validate-push",
    "format:check:lisa": "node scripts/lib/worktree-dependencies.mjs && prettier --check .",
    "knip:check:lisa": "node scripts/lib/worktree-dependencies.mjs && knip",
    "lint:lisa": "node scripts/lib/worktree-dependencies.mjs && oxlint && eslint . --quiet",
    "lint:slow:lisa": "node scripts/lib/worktree-dependencies.mjs && eslint . --config eslint.slow.config.ts --quiet",
    "nightly:health": "node scripts/check-nightly-e2e-health.mjs",
    "sg:scan:lisa": "node scripts/lib/worktree-dependencies.mjs && ast-grep scan",
    "sg:test": "node scripts/lib/worktree-dependencies.mjs && ast-grep test",
    "test:cov:lisa": "node scripts/lib/worktree-dependencies.mjs && lisa-test-run --profile npm-package --adapter vitest -- vitest run --coverage",
    "test:cov:unit:lisa": "node scripts/lib/worktree-dependencies.mjs && LISA_COVERAGE_SCOPE=unit lisa-test-run --profile npm-package --adapter vitest -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'",
    "test:integration:lisa": "node scripts/lib/worktree-dependencies.mjs && lisa-test-run --profile npm-package --adapter vitest -- vitest run '.integration.' 'integration/'",
    "test:lisa": "node scripts/lib/worktree-dependencies.mjs && lisa-test-run --profile npm-package --adapter vitest -- vitest run",
    "test:mutation": "node scripts/lib/worktree-dependencies.mjs && LISA_TEST_SCRATCH_PREFIXES='[\"lisa-mutation-\",\"worker-\"]' lisa-test-run --profile npm-package --adapter direct -- node scripts/lisa-mutation.mjs",
    "test:node:lisa": "node scripts/lib/worktree-dependencies.mjs && LISA_TEST_SCRATCH_PREFIXES='[\"node-\"]' lisa-test-run --profile npm-package --adapter direct -- node scripts/lisa-test-node.mjs",
    "test:unit:lisa": "node scripts/lib/worktree-dependencies.mjs && lisa-test-run --profile npm-package --adapter vitest -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'",
    "test:watch:lisa": "node scripts/lib/worktree-dependencies.mjs && lisa-test-run --profile npm-package --adapter vitest -- vitest",
    "typecheck:lisa": "node scripts/lib/worktree-dependencies.mjs && tsc --noEmit"
  },
  "engines": {
    "npm": "please-use-bun",
    "yarn": "please-use-bun",
    "pnpm": "please-use-bun",
    "bun": "1.3.8",
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin"
  ],
  "types": "./dist/index.d.ts",
  "name": "@codyswann/aws-soc2-setup",
  "version": "1.1.4",
  "description": "Automated AWS Control Tower setup for SOC 2 compliance — account provisioning, IAM Identity Center, security services, backup, and KMS as a typed CLI",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "aws-soc2-setup": "./bin/aws-soc2-setup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodySwannGT/aws-soc2-setup.git"
  },
  "homepage": "https://github.com/CodySwannGT/aws-soc2-setup#readme",
  "bugs": {
    "url": "https://github.com/CodySwannGT/aws-soc2-setup/issues"
  },
  "author": "Cody Swann",
  "license": "MIT",
  "keywords": [
    "aws",
    "soc2",
    "control-tower",
    "compliance",
    "iam-identity-center",
    "cli",
    "security"
  ],
  "dependencies": {
    "@aws-sdk/client-auditmanager": "^3.1063.0",
    "@aws-sdk/client-backup": "^3.1063.0",
    "@aws-sdk/client-config-service": "^3.1063.0",
    "@aws-sdk/client-controltower": "^3.1063.0",
    "@aws-sdk/client-eventbridge": "3.1063.0",
    "@aws-sdk/client-guardduty": "^3.1063.0",
    "@aws-sdk/client-iam": "^3.1063.0",
    "@aws-sdk/client-identitystore": "^3.1063.0",
    "@aws-sdk/client-inspector2": "^3.1063.0",
    "@aws-sdk/client-kms": "^3.1063.0",
    "@aws-sdk/client-macie2": "^3.1063.0",
    "@aws-sdk/client-organizations": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-securityhub": "^3.1063.0",
    "@aws-sdk/client-service-catalog": "^3.1063.0",
    "@aws-sdk/client-sns": "3.1063.0",
    "@aws-sdk/client-sso-admin": "^3.1063.0",
    "@aws-sdk/client-sts": "^3.1063.0",
    "@aws-sdk/credential-providers": "^3.1063.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "resolutions": {
    "@isaacs/brace-expansion": "^5.0.1",
    "axios": ">=1.20.0",
    "picomatch": ">=4.0.4",
    "minimatch": ">=10.2.1",
    "yaml": ">=2.8.3",
    "smol-toml": ">=1.6.1",
    "handlebars": ">=4.7.9",
    "esbuild": ">=0.28.1",
    "lodash": ">=4.18.1",
    "ws": ">=8.21.0",
    "form-data": ">=4.0.6",
    "multer": ">=2.3.0",
    "undici": "^6.28.1",
    "vite": "$vite",
    "systeminformation": ">=5.31.7"
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "axios": ">=1.20.0",
    "picomatch": ">=4.0.4",
    "minimatch": ">=10.2.1",
    "yaml": ">=2.8.3",
    "smol-toml": ">=1.6.1",
    "handlebars": ">=4.7.9",
    "esbuild": ">=0.28.1",
    "lodash": ">=4.18.1",
    "ws": ">=8.21.0",
    "form-data": ">=4.0.6",
    "multer": ">=2.3.0",
    "undici": "^6.28.1",
    "@smithy/types": "4.16.1",
    "vite": "$vite",
    "systeminformation": ">=5.31.7"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "@codyswann/lisa",
    "@sentry/cli"
  ]
}
